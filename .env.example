# ─────────────────────────────────────────────────────────
# Local development — copy to .env and fill in values
# For Railway deployment — set these as environment variables
# in the Railway service dashboard (not in a file).
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# Railway: add a PostgreSQL plugin — DATABASE_URL is injected automatically.
# The PostgreSQL instance must have the pgvector extension available.
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk

# ── Redis ─────────────────────────────────────────────────
# Railway: add a Redis plugin — REDIS_URL is injected automatically.
REDIS_URL=redis://localhost:6379

# ── Better Auth ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret
# Railway: set to your Railway app URL, e.g. https://helpdesk-production.up.railway.app
BETTER_AUTH_URL=http://localhost:3001

# ── App ───────────────────────────────────────────────────
# Railway: PORT is injected automatically — do not set it.
PORT=3001
NODE_ENV=development
# Railway: set to your Railway app URL (same as BETTER_AUTH_URL for single-service deploy).
FRONTEND_URL=http://localhost:5173

# ── Seed (optional) ───────────────────────────────────────
# Used by `bun run db:seed` to create the initial admin user.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# ── Email (Mailgun) ───────────────────────────────────────
# Dashboard → Sending → Domain settings → API keys (starts with "key-").
MAILGUN_API_KEY=
# The sending domain you verified with Mailgun, e.g. mg.yourdomain.com
MAILGUN_DOMAIN=
# The From address on outbound replies, e.g. support@mg.yourdomain.com
MAILGUN_FROM_EMAIL=
# EU-region accounts must set this to https://api.eu.mailgun.net
MAILGUN_API_URL=https://api.mailgun.net

# ── AI ────────────────────────────────────────────────────
# Required — TypeSafe Jev makes routing decisions and OpenAI writes approved replies.
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# ── Webhooks ──────────────────────────────────────────────
# Mailgun's HTTP webhook signing key (Dashboard → Sending → Webhooks).
# NOT the API key. Set this in production — inbound requests are then required
# to carry a valid Mailgun HMAC signature.
MAILGUN_SIGNING_KEY=

# Fallback shared secret, used only when MAILGUN_SIGNING_KEY is unset (local
# dev and e2e tests, where requests aren't signed by Mailgun).
# Generate with: openssl rand -base64 32
# Send via header: x-webhook-secret: <value>  OR  ?webhook_secret=<value>
WEBHOOK_SECRET=

# ── Sentry (optional) ─────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ─────────────────────────────────────────────────────────
# Railway deployment checklist
# ─────────────────────────────────────────────────────────
# 1. Create a Railway project and add this repo.
# 2. Add a PostgreSQL plugin — ensure pgvector is enabled.
# 3. Add a Redis plugin.
# 4. Set the following env vars in the Railway service:
#      NODE_ENV=production
#      BETTER_AUTH_SECRET=<openssl rand -base64 32>
#      BETTER_AUTH_URL=https://<your-app>.railway.app
#      FRONTEND_URL=https://<your-app>.railway.app
#      TYPESAFE_API_KEY=<your key>
#      OPENAI_API_KEY=<your key>
#      MAILGUN_API_KEY=<your key>
#      MAILGUN_DOMAIN=<your verified sending domain>
#      MAILGUN_FROM_EMAIL=<your sender address>
#      MAILGUN_SIGNING_KEY=<webhook signing key>
# 5. DATABASE_URL and REDIS_URL are injected automatically by Railway plugins.
# 6. PORT is injected automatically — do not set it.
#    In Mailgun: Receiving → Routes → create a route matching your support
#    address with action Store and notify:
#      https://<your-app>.railway.app/api/webhooks/email
# 7. After first deploy, seed the admin user:
#      Set SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD, then run:
#      cd backend && bun run db:seed
#      (or use Railway's one-off command runner)
# ─────────────────────────────────────────────────────────

# Demo mode — for the public portfolio deployment. Set to "true" to suppress all
# outbound email, cap the AI endpoints at 20 calls/hour per user, and block
# create/update/delete on users. Any other value (or unset) leaves it off.
DEMO_MODE=false
