{
  "name": "@helpdesk/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate:prod": "prisma migrate deploy",
    "dev": "bun --env-file ../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "bun --env-file ../.env prisma/seed.ts",
    "db:seed:test": "bun --env-file ../.env.test prisma/seed.ts",
    "dev:test": "bun --env-file ../.env.test src/index.ts",
    "db:migrate:test": "bun --env-file ../.env.test -e \"import { execSync } from 'child_process'; execSync('npx prisma migrate deploy', { stdio: 'inherit' });\""
  },
  "dependencies": {
    "@ai-sdk/openai": "1",
    "@anthropic-ai/sdk": "0.36.3",
    "@helpdesk/core": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7",
    "@sendgrid/inbound-mail-parser": "8.0.0",
    "@sendgrid/mail": "8.1.6",
    "@sentry/node": "10.55.0",
    "ai": "4",
    "better-auth": "1.6.2",
    "bullmq": "5.73.4",
    "connect-pg-simple": "10.0.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "morgan": "1.10.0",
    "multer": "2.1.1",
    "pg": "8.20.0",
    "pg-boss": "12.18.2",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/express-session": "1.18.1",
    "@types/morgan": "1.9.9",
    "@types/multer": "2.1.0",
    "@types/node": "22.14.0",
    "@types/pg": "8.20.0",
    "prisma": "7",
    "typescript": "5.8.3"
  }
}
